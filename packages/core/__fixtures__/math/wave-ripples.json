{
  "version": "glyph/0.1",
  "title": "Wave equation: Gaussian impulse ripples (RFC #4 v2)",
  "data": {
    "pde_solve": {
      "shape": "pde-solve",
      "kind": "wave",
      "domain": { "x": [-1, 1], "y": [-1, 1] },
      "grid": { "rows": 24, "cols": 24 },
