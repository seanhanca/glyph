      "params": { "c": 0.6, "gamma": 0.01 },
      "boundary": "clamp",
      "steps": 25,
      "dt": 0.05
    }
  },
  "layers": [
    {
      "mark": "heatmap",
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": { "domain": [-1, 1] }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": { "domain": [-1, 1] }
        },
        "color": {
          "field": "u",
          "type": "quantitative"
        }
      }
    }
  ]
}
