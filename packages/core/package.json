{
  "name": "@glyph/core",
  "version": "0.3.0",
  "description": "Glyph core — spec AST, compiler, scenegraph, SVG renderer.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./spec.schema.json": "./dist/spec.schema.json"
  },
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/seanhanca/glyph.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/seanhanca/glyph",
  "bugs": "https://github.com/seanhanca/glyph/issues",
  "keywords": ["charts", "visualization", "svg", "grammar-of-graphics", "deterministic", "agents"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/generate-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "expr-eval": "^2.0.2",
    "katex": "0.16.47",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "zod-to-json-schema": "^3.23.5"
  }
}
