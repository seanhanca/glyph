{
  "data": {
    "source": "../../taxi.csv",
    "format": "csv",
    "transform": "SELECT pickup_hour, fare, rides FROM glyph_src_main ORDER BY pickup_hour"
  },
  "layers": [
    { "mark": "bar", "encoding": { "x": "pickup_hour", "y": "rides" } },
    { "mark": "line", "encoding": { "x": "pickup_hour", "y": { "field": "fare", "scale": { "side": "right" } } } }
  ],
  "title": "Rides + fare (dual y-axis)"
}
