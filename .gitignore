# Showcase: raw OWID CSV (~94 MB) — re-fetched by sandbox-covid/build_data.py
sandbox-covid/data/owid-covid-data.csv

# Python bindings build artifacts and caches
bindings/python/dist/
bindings/python/__pycache__/
bindings/python/*.egg-info/
bindings/python/.pytest_cache/
bindings/python/.ruff_cache/
bindings/python/.mypy_cache/

# Playground bundle source maps (generated artifact;
# the bundle itself IS committed so GH Pages serves it without a build step).
# Note: site/play/spec.schema.json is ALSO a generated artifact, but it IS
# committed for the same reason — Monaco fetches it at runtime for spec
# autocomplete + validation, so it must be served from the static site.
site/play/glyph-bundle.js.map

# Local scratch directory — sample CSVs and experimental sketches devs
# drop in while iterating. Never shipped, never tested in CI.
sandbox/

# Python bindings: every `__pycache__/` under the tree (the existing
# entries above only covered specific paths — this catches subdirs like
# bindings/python/tests/__pycache__/ that pytest creates per test file).
**/__pycache__/

# Launch toolkit secrets and runtime state
scripts/launch/.env.launch
scripts/launch/.env
scripts/launch/.influencer-*.json
scripts/launch/chrome_queue.json
